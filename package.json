{
  "name": "aiwiki",
  "version": "0.1.0",
  "private": true,
  "description": "AiWiki —— 从 AI 第一人称写的工程百科，包含 AI 编码误区与 LLM 隐私保护两个并列主题。",
  "scripts": {
    "docusaurus": "docusaurus",
    "gen:meta": "node scripts/gen-entry-meta.js",
    "gen:mcp-index": "node scripts/gen-mcp-index.js",
    "prestart": "node scripts/gen-entry-meta.js && node scripts/gen-mcp-index.js",
    "start": "docusaurus start",
    "prebuild": "node scripts/gen-entry-meta.js && node scripts/gen-mcp-index.js",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "check:i18n": "node scripts/check-i18n.js",
    "check:mirror": "node scripts/check-mirror.js",
    "check:mirror-deep": "node scripts/check-mirror-deep.js",
    "check:counts": "node scripts/check-counts.js",
    "check:content": "node scripts/check-content.js",
    "review:queue": "node scripts/check-content.js --review-queue",
    "test:mcp": "node --test mcp/test/*.test.js",
    "test:examples": "node examples/permissions/demo.mjs && node mcp/examples/least-privilege/demo.mjs && node examples/retry/demo.mjs && node --test examples/retry/retry.test.mjs mcp/examples/least-privilege/session.test.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "^3.8.0",
    "@docusaurus/preset-classic": "^3.8.0",
    "@docusaurus/theme-mermaid": "^3.8.0",
    "@easyops-cn/docusaurus-search-local": "^0.55.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.8.0",
    "cspell": "^10.0.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
